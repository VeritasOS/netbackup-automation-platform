---
exclude_paths:
  - scm/

# ansible-lint configuration
# Profile: safety — enforces safety-tier rules; style/production rules suppressed via skip_list.
profile: safety
skip_list:
  - name[template]
  - role-name[path]
  - command-instead-of-module
  - var-naming[no-role-prefix]
